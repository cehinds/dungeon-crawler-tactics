{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dungeon Crawler Tactics campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "partySize",
    "energyPerRound",
    "roster",
    "classStats",
    "encounters",
    "startingInventory",
    "rewards",
    "tagRules",
    "progression",
    "equipment"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "partySize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "energyPerRound": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "roster": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/roster"
      }
    },
    "classStats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stats"
      }
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/encounter"
      }
    },
    "startingInventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inventory"
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reward"
      }
    },
    "tagRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tagRule"
      }
    },
    "compatibleContentVersions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "progression": {
      "$ref": "#/$defs/progression"
    },
    "equipment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/equipment"
      }
    },
    "stances": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/tacticalMode"
      }
    },
    "forms": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/tacticalMode"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "coord": {
      "type": "integer",
      "minimum": 0,
      "maximum": 29
    },
    "hp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "energy": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "move": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "classId",
        "selected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "classId": {
          "$ref": "#/$defs/id"
        },
        "selected": {
          "type": "boolean"
        },
        "artId": {
          "type": "string"
        },
        "deployable": {
          "type": "boolean"
        },
        "innateAbilityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "replacesId": {
          "$ref": "#/$defs/id"
        },
        "legacyClassId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classId",
        "hp",
        "energy",
        "move"
      ],
      "properties": {
        "classId": {
          "$ref": "#/$defs/id"
        },
        "hp": {
          "$ref": "#/$defs/hp"
        },
        "energy": {
          "$ref": "#/$defs/energy"
        },
        "move": {
          "$ref": "#/$defs/move"
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/coord"
        },
        "y": {
          "$ref": "#/$defs/coord"
        },
        "cost": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "blocked",
        "tags"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/coord"
        },
        "y": {
          "$ref": "#/$defs/coord"
        },
        "blocked": {
          "type": "boolean"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      }
    },
    "enemy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "classId",
        "x",
        "y",
        "hp",
        "energy",
        "move",
        "tags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "classId": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "$ref": "#/$defs/coord"
        },
        "y": {
          "$ref": "#/$defs/coord"
        },
        "hp": {
          "$ref": "#/$defs/hp"
        },
        "energy": {
          "$ref": "#/$defs/energy"
        },
        "move": {
          "$ref": "#/$defs/move"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "artId": {
          "type": "string"
        }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "width",
        "height",
        "xp",
        "playerSpawns",
        "tiles",
        "enemies",
        "exploration"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 30
        },
        "height": {
          "type": "integer",
          "minimum": 4,
          "maximum": 30
        },
        "xp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "playerSpawns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tile"
          }
        },
        "enemies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/enemy"
          }
        },
        "exploration": {
          "$ref": "#/$defs/exploration"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "count"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "itemId",
        "count",
        "heal"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string"
        },
        "itemId": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "heal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "tagRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "durationRounds"
      ],
      "properties": {
        "tag": {
          "$ref": "#/$defs/id"
        },
        "occupantTag": {
          "type": "string"
        },
        "durationRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "entryDamage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "turnDamage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "movePenalty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "energyPenalty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "explorationPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "kind",
        "x",
        "y",
        "itemId",
        "count"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "encounter",
            "cache",
            "lore"
          ]
        },
        "x": {
          "$ref": "#/$defs/coord"
        },
        "y": {
          "$ref": "#/$defs/coord"
        },
        "itemId": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "exploration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "width",
        "height",
        "startX",
        "startY",
        "discoveryRadius",
        "walls",
        "points"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 30
        },
        "height": {
          "type": "integer",
          "minimum": 4,
          "maximum": 30
        },
        "startX": {
          "$ref": "#/$defs/coord"
        },
        "startY": {
          "$ref": "#/$defs/coord"
        },
        "discoveryRadius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "walls": {
          "type": "array",
          "maxItems": 900,
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/explorationPoint"
          }
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xpThresholds",
        "hpPerLevel",
        "manaPerLevel",
        "movePerLevel",
        "skillUnlocks"
      ],
      "properties": {
        "xpThresholds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "hpPerLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "manaPerLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "movePerLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "skillUnlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillUnlock"
          }
        }
      }
    },
    "skillUnlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "rosterId",
        "abilityId",
        "level"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "rosterId": {
          "$ref": "#/$defs/id"
        },
        "abilityId": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "type": "integer",
          "minimum": 2,
          "maximum": 19
        }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "slot",
        "hpBonus",
        "manaBonus",
        "moveBonus",
        "abilityIds",
        "unlockEncounter"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "slot": {
          "enum": [
            "weapon",
            "armor",
            "charm"
          ]
        },
        "hpBonus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "manaBonus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "moveBonus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "abilityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "unlockEncounter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "tacticalMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "hpBonus",
        "manaBonus",
        "moveBonus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rosterId": {
          "type": "string",
          "minLength": 1
        },
        "hpBonus": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10
        },
        "manaBonus": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3
        },
        "moveBonus": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1
        },
        "grantTag": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
