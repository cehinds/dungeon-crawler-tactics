{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tile side tags",
  "description": "The edges object on a Book Location Tiles asset, in local north-up orientation. Gameplay collision is separate.",
  "type": "object",
  "required": [
    "north",
    "east",
    "south",
    "west"
  ],
  "additionalProperties": false,
  "properties": {
    "north": {
      "$ref": "#/$defs/tags"
    },
    "east": {
      "$ref": "#/$defs/tags"
    },
    "south": {
      "$ref": "#/$defs/tags"
    },
    "west": {
      "$ref": "#/$defs/tags"
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$(?![\\s\\S])"
      },
      "contains": {
        "type": "string",
        "pattern": "^join\\."
      },
      "minContains": 1,
      "maxContains": 1
    }
  }
}
