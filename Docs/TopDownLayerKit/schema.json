{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top-down-layer-scene-v1",
  "title": "Top-down concept scene input",
  "description": "Exact visible source decomposition and inferred reusable interpretation are separate modes. Visual quality requires human review.",
  "type": "object",
  "required": ["schemaVersion", "sceneId", "source", "grid", "underlay", "components"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sceneId": {"type": "string"},
    "source": {"type":"object","required":["path","sha256","width","height"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1}}},
    "grid": {"type":"object","required":["major","sub"],"properties":{"major":{"const":14},"sub":{"const":3}}},
    "underlay": {"$ref":"#/$defs/base"},
    "components": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/exactComponent"}},
    "reusable": {"type":"object","required":["base","components"],"properties":{"base":{"$ref":"#/$defs/base"},"components":{"type":"array","items":{"$ref":"#/$defs/component"}},"limitations":{"type":"array","items":{"type":"string"}}}},
    "limitations":{"type":"array","items":{"type":"string"}}
  },
  "$defs": {
    "provenance":{"type":"object","required":["kind"],"properties":{"kind":{"type":"string"}},"description":"Use exact-visible-source-extraction, ai-interpolated-hidden-surface, ai-generated-completed-surface, ai-generated-completed-component or source-derived-inferred-completed-surface accurately. Include method/tool/prompt and limitations when applicable."},
    "base":{"type":"object","required":["path","provenance"],"properties":{"path":{"type":"string"},"provenance":{"$ref":"#/$defs/provenance"}}},
    "component":{"type":"object","required":["id","category","asset","x","y","z","provenance"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]*$"},"category":{"type":"string"},"asset":{"type":"string"},"x":{"type":"integer"},"y":{"type":"integer"},"z":{"type":"integer"},"gridAddress":{"type":"string"},"provenance":{"$ref":"#/$defs/provenance"},"replacesExactIds":{"type":"array","items":{"type":"string"}}}},
    "exactComponent":{"allOf":[{"$ref":"#/$defs/component"},{"type":"object","required":["mask","bounds"],"properties":{"mask":{"type":"string","description":"Full native-canvas grayscale binary 0/255 mask."},"bounds":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"integer"},"description":"xywh crop, aligned to x/y; source RGB and mask alpha are validated."}}}]}
  }
}
