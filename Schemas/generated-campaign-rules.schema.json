{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-campaign-rules.schema.json",
  "title": "Generated expedition campaign rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "label",
    "families",
    "depths"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "zones",
          "connections"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "zones": {
            "$ref": "exploration-floor-rules.schema.json#/properties/zones"
          },
          "connections": {
            "$ref": "exploration-floor-rules.schema.json#/properties/connections"
          }
        }
      }
    },
    "depths": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "familyId",
          "kitId",
          "groups",
          "enemyRecipe",
          "discoveries",
          "propLabelPattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "familyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kitId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "groups": {
            "$ref": "exploration-floor-rules.schema.json#/properties/groups"
          },
          "enemyRecipe": {
            "$ref": "exploration-floor-rules.schema.json#/properties/enemyRecipe"
          },
          "discoveries": {
            "$ref": "exploration-floor-rules.schema.json#/properties/discoveries"
          },
          "propLabelPattern": {
            "$ref": "exploration-floor-rules.schema.json#/properties/propLabelPattern"
          }
        }
      }
    }
  }
}
