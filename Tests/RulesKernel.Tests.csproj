<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup>
    <Compile Remove="GameTests/**" />
    <Compile Remove="ScenarioTests/**" />
    <Compile Remove="CustomMapTests/**" />
    <Compile Include="../UnityPackage/Runtime/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <None Include="../UnityPackage/Runtime/Data/combat-content.json" Link="combat-content.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../UnityPackage/Runtime/Data/starter-content.json" Link="starter-content.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
