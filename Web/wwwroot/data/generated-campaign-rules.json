              "requiredMaterialTags": []
            },
            {
              "id": "ability.ignite_oil_binding",
              "label": "Heat the oil binding",
              "description": "Use an available Fire ability on the oil-slicked grille. The normal Mana cost applies; the passage stays open.",
              "kind": "ability",
              "abilityTag": "element.fire",
              "requiredMaterialTags": [
                "surface.oil"
              ]
            },
