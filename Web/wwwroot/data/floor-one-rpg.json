  "dialogue": {
    "false-guild": {
      "speaker": "Goblin sign crew",
      "text": "The painted guild sign promises help. Something about the alley feels staged.",
      "note": "Original paraphrase; encounter framing follows the false guild setup."
    },
    "mordecai": {
      "speaker": "Mordecai",
      "text": "Welcome to the Tutorial Guild. Take a breath, learn the basics, then choose your route carefully.",
      "note": "Original short NPC line; Mordecai is a guide, not a deployable party member."
    },
    "hoarder": {
      "speaker": "Hoarder",
      "text": "The nest is crowded with stolen things. Keep your eyes on the Scatterers.",
      "note": "Original encounter prompt; no novel dialogue copied."
    },
    "tally": {
      "speaker": "Tally",
      "text": "You can rest here and sort out what you found before heading back into the halls.",
      "note": "Original safe-room interaction."
    },
    "workshop": {
      "speaker": "Workshop goblin",
      "text": "The machines rattle, the fuses hiss, and the crew has noticed you.",
      "note": "Original encounter prompt; room layout and combat are adaptations."
    },
    "juicer": {
      "speaker": "Gym announcer",
      "text": "The gym is still open. Step into the ring if you want to settle this the hard way.",
      "note": "Original prompt; tactical encounter is adapted."
    },
    "meadow-lark": {
      "speaker": "Meadow Lark",
      "text": "Stay alert near the stair. The noise below carries farther than you think.",
      "note": "Original paraphrase; encounter placement is adapted."
    },
    "ball-of-swine": {
      "speaker": "Dungeon announcer",
      "text": "The descent is open. Something enormous is waiting below.",
      "note": "Original transition line; descent and battle pacing are adaptations."
    }
